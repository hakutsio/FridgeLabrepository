# Copie este arquivo para .env e troque TODOS os valores antes de subir o laboratório.
# O arquivo .env está no .gitignore: as senhas reais nunca vão para o repositório.

# Administrador do PostgreSQL (usado só para criar as tabelas)
POSTGRES_PASSWORD=troque-esta-senha

# Conta do sistema no banco (fridge_app)
DB_PASSWORD=troque-esta-senha

# Usuários do site
TEACHER_PASSWORD=troque-esta-senha
STUDENT_PASSWORD=troque-esta-senha

# Documentação Swagger (true só em desenvolvimento; acesso apenas do professor)
SWAGGER_ENABLED=false
